# -------------------------------------------------------------------
# ASSET Global .gitignore
# Bu dosya ortamdaki Node.js, Flutter ve Arduino derleme/kalıntı dizinlerini tutar
# -------------------------------------------------------------------

# ── General OS / Editors ─────────────
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.suo
*.user
*.swp

# ── Node.js (Backend) ────────────────
backend/node_modules/
backend/npm-debug.log
backend/yarn-error.log
backend/.env
backend/.env.local
backend/coverage/
backend/dist/
backend/build/
archive/

# ── Flutter / Dart (mobileApp) ───────
mobileApp/.dart_tool/
mobileApp/.packages
mobileApp/build/
mobileApp/.flutter-plugins
mobileApp/.flutter-plugins-dependencies
mobileApp/*.iml
mobileApp/android/key.properties
mobileApp/ios/**/*.pbxuser
mobileApp/ios/**/*.mode1v3
mobileApp/ios/**/*.mode2v3
mobileApp/ios/**/*.pbxuser
mobileApp/ios/**/*.perspectivev3
mobileApp/ios/Flutter/Flutter.podspec
mobileApp/ios/Flutter/Generated.xcconfig
mobileApp/ios/Flutter/app.flx
mobileApp/ios/Flutter/app.zip
mobileApp/ios/Flutter/flutter_assets/
mobileApp/ios/Flutter/flutter_export_environment.sh
mobileApp/ios/Runner/GeneratedPluginRegistrant.*

# ── Arduino / ESP32 (iot) ────────────
iot/**/*.elf
iot/**/*.bin
iot/**/*.hex
iot/**/*.map
iot/**/*.lst
iot/**/*.o
iot/**/*.d
iot/**/*.eep
iot/**/*.a
