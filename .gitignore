# =========================
# ASSET Projesi .gitignore
# =========================

# ── Genel İşletim Sistemi ve Tool Dosyaları ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# ── IDE & Editörler ──
.idea/
.vscode/
*.suo
*.user
*.bak

# ── Backend (Node.js) & Frontend (React/Vite) ──
node_modules/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Çevresel değişkenler (Şifreler, API Anahtarları)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build çıktıları
dist/
build/
coverage/
.next/
out/

# ── MobileApp (Flutter / Dart) ──
.dart_tool/
.packages
.pub-cache/
.pub/
build/
coverage/
*.log
*.crash

# Android / iOS özel dosyaları
**/android/local.properties
**/android/key.properties
**/ios/.symlinks/
**/ios/Pods/
*.jks
*.keystore
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
Flutter/app.flx
flutter_export_environment.sh

# ── IoT (Arduino / ESP32) ──
*.elf
*.bin
*.hex
*.o
*.a
*.map
build/
compile_commands.json
.vscode/arduino.json
.vscode/c_cpp_properties.json

# ── Yedek ve Arşiv Klasörleri ──
archive/
yedek/
*.zip
*.tar.gz
*.rar
